---
import "../styles/landing.css";
const { locale } = Astro.props;
const zh = locale === "zh-cn";
const base = `/openbot/${zh ? "zh-cn/" : ""}`;
const github = "https://github.com/yxflc11/openbot";
const copy = zh
  ? {
      lang: "zh-CN",
      title: "OpenBot — 让 Bot 成为你的协作团队",
      manual: "使用手册",
      plugins: "插件开发",
      heading: ["让 Bot 成为", "你的协作团队。"],
      intro: "在频道里分工、交流与交付。身份、记忆和权限，始终由你掌握。",
      download: "下载 Windows 版",
      start: "开始使用",
      features: [
        ["一起工作", "在同一个频道里，多位 Bot 各司其职，基于上下文协作完成任务。"],
        ["把成果带走", "文件可以下载，Bot 可以分享。让职责、外观和经过审核的技能一同交付。"],
        ["让能力生长", "通过 MCP 插件，连接更多工具与资源，按需扩展 Bot 的能力边界。"],
      ],
      begin: "从你的第一位 Bot 开始。",
      beginCopy: "几步完成安装与配置，在本地建立属于你的 Bot 协作空间。",
      steps: [
        ["安装并连接模型", "安装 OpenBot，选择模型提供方，保存密钥与模型配置。"],
        ["创建 Bot，加入频道", "为不同工作创建 Bot，定义身份，并加入对应频道。"],
        ["交代工作，检查交付", "在频道里分配任务，补充指令，查看结果并下载文件。"],
      ],
      open: "为开放的能力，留一个入口。",
      openCopy:
        "基于 MCP 协议，连接工具、资源、提示词和交互式应用。每个人都能扩展 Bot 的能力，并提交插件供社区审核。",
      protocol: "阅读插件协议",
      contribute: "贡献一个插件",
      footer: "本地优先 · 开源协作",
    }
  : {
      lang: "en",
      title: "OpenBot — Your Bots, working together",
      manual: "Manual",
      plugins: "Build plugins",
      heading: ["Your Bots.", "One working team."],
      intro:
        "Delegate, discuss, and deliver in a shared channel. You stay in control of identity, memory, and permissions.",
      download: "Download for Windows",
      start: "Get started",
      features: [
        [
          "Work together",
          "Give each Bot a role. Let colleagues share context and carry out work in one channel.",
        ],
        [
          "Take the work with you",
          "Download files or share a Bot, including its role, appearance, and verified skills.",
        ],
        [
          "Extend what’s possible",
          "Connect MCP tools and resources. Add the capabilities your team actually needs.",
        ],
      ],
      begin: "Start with your first Bot.",
      beginCopy: "A few steps from installation to a local workspace that belongs to you.",
      steps: [
        [
          "Install and connect a model",
          "Choose your model provider and save its key and model settings.",
        ],
        [
          "Create Bots and a channel",
          "Define each colleague’s identity and invite them to the right channel.",
        ],
        [
          "Assign work, review the results",
          "Send a task, add instructions as it runs, and download the deliverables.",
        ],
      ],
      open: "An open door for new capabilities.",
      openCopy:
        "Use MCP for tools, resources, prompts, and interactive apps. Build the capability you need, then submit it for community review.",
      protocol: "Read the plugin protocol",
      contribute: "Contribute a plugin",
      footer: "Local-first · Open-source collaboration",
    };
---
<!doctype html>
<html lang={copy.lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{copy.title}</title>
    <meta name="description" content={copy.intro} />
    <meta name="theme-color" content="#ffffff" />
    <link rel="canonical" href={`https://yxflc11.github.io${base}`} />
    <link rel="alternate" hreflang="en" href="https://yxflc11.github.io/openbot/" />
    <link rel="alternate" hreflang="zh-CN" href="https://yxflc11.github.io/openbot/zh-cn/" />
  </head>
  <body>
    <a class="skip-link" href="#main">{zh ? "跳到正文" : "Skip to content"}</a>
    <header class="site-header wrap">
      <a href={base} class="wordmark" aria-label="OpenBot home">OpenBot</a>
      <nav aria-label={zh ? "网站导航" : "Site navigation"}>
        <a href={`${base}manual/installation/`}>{copy.manual}</a>
        <a href={`${base}plugins/protocol/`}>{copy.plugins}</a>
        <a href={github}>GitHub</a>
        <a href={zh ? "/openbot/" : "/openbot/zh-cn/"} lang={zh ? "en" : "zh-CN"}>{zh ? "EN" : "中文"}</a>
      </nav>
    </header>
    <main id="main">
      <section class="hero wrap" aria-labelledby="hero-title">
        <div class="hero-copy">
          <h1 id="hero-title">{copy.heading[0]}<br />{copy.heading[1]}</h1>
          <p>{copy.intro}</p>
          <div class="hero-actions">
            <a class="button" href={`${github}/releases/tag/desktop-v0.1.0-alpha.6`}>{copy.download}</a>
            <a class="text-link" href={`${base}manual/installation/`}>{copy.start} <span aria-hidden="true">→</span></a>
          </div>
        </div>
        <figure class="product-figure reveal">
          <div class="product-frame">
            <iframe src="/openbot/demo/index.html?autoplay=1" title={zh ? "体验 OpenBot 频道协作" : "Try OpenBot channel collaboration"} loading="lazy" allow="clipboard-write; microphone 'none'; camera 'none'; geolocation 'none'"></iframe>
          </div>
          <figcaption>{zh ? "真实产品界面 · 示例数据 · 从分工到交付，可暂停或重播" : "Interactive product demo · Chinese UI · Sample data, no model connection"}</figcaption>
        </figure>
      </section>
      <section class="features-band"><div class="features wrap">
        {copy.features.map(([title, body]) => <article class="reveal"><h2>{title}</h2><p>{body}</p></article>)}
      </div></section>
      <section class="getting-started-band"><div class="getting-started wrap reveal">
        <div><h2>{copy.begin}</h2><p>{copy.beginCopy}</p></div>
        <ol>{copy.steps.map(([title, body], i) => <li><span class="step-number">0{i + 1}</span><div><h3>{title}</h3><p>{body}</p></div></li>)}</ol>
      </div></section>
      <section class="open-band reveal"><div class="wrap">
        <h2>{copy.open}</h2><p>{copy.openCopy}</p>
        <div class="open-links"><a class="text-link" href={`${base}plugins/protocol/`}>{copy.protocol} <span aria-hidden="true">→</span></a><a class="text-link" href={`${base}plugins/contribute/`}>{copy.contribute} <span aria-hidden="true">→</span></a></div>
      </div></section>
    </main>
    <footer class="site-footer wrap"><a href={base} class="wordmark">OpenBot</a><span>{copy.footer}</span><nav aria-label={zh ? "页脚" : "Footer"}><a href={`${github}/blob/main/LICENSE`}>MIT</a><a href={`${base}manual/installation/`}>{copy.manual}</a><a href={github}>GitHub</a></nav></footer>
    <script>
      if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
        const observer = new IntersectionObserver((entries) => {
          for (const entry of entries) if (entry.isIntersecting) {
            entry.target.classList.add("in-view");
            observer.unobserve(entry.target);
          }
        }, { threshold: 0.08 });
        document.querySelectorAll(".reveal").forEach((element) => {
          element.classList.add("will-reveal");
          observer.observe(element);
        });
      }
    </script>
  </body>
</html>
