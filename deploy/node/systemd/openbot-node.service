[Unit]
Description=OpenBot execution node
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=openbot
Group=openbot
WorkingDirectory=/opt/openbot
EnvironmentFile=/etc/openbot/node.env
ExecStart=/usr/bin/node /opt/openbot/apps/node/dist/index.js
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/openbot

[Install]
WantedBy=multi-user.target
