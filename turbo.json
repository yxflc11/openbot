{
  "$schema": "https://turbo.build/schema.json",
  "globalPassThroughEnv": ["GITHUB_EVENT_NAME", "GITHUB_EVENT_PATH", "OPENBOT_DATABASE_URL"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    }
  }
}
