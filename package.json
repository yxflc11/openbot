{
  "name": "openbot",
  "version": "0.0.0",
  "private": true,
  "description": "Self-hosted digital employee control plane with replaceable execution nodes.",
  "license": "MIT",
  "type": "module",
  "packageManager": "npm@10.9.8",
  "engines": {
    "node": ">=22.0.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "providers/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build",
    "db:up": "docker compose --env-file .env -f deploy/server/compose.yaml up -d postgres",
    "db:stop": "docker compose --env-file .env -f deploy/server/compose.yaml stop postgres",
    "dev": "turbo run dev --parallel",
    "dev:server": "npm run dev --workspace @openbot/server",
    "dev:web": "npm run dev --workspace @openbot/web",
    "dev:node": "npm run dev --workspace @openbot/node",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.11",
    "@types/node": "26.4.1",
    "turbo": "2.10.12",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  }
}
